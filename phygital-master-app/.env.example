# ── Database (PostgreSQL on your VPS) ───────────────────────
# Point the app at your VPS Postgres with one line. Example:
#   DATABASE_URL=postgres://USER:PASSWORD@YOUR_VPS_IP:5432/phygital
# DATABASE_URL=

# SSL: ON by default. For a plain self-hosted VPS Postgres without TLS,
# turn it off (or append ?sslmode=disable to the URL):
# DB_SSL=false

# LOCAL Postgres fallback (used only when DATABASE_URL is unset):
PGHOST=localhost
PGPORT=5432
PGDATABASE=phygital
# PGUSER=mi1k
# PGPASSWORD=

# ── Server ──────────────────────────────────────────────────
PORT=4173
